[250.962463, "o", "\u001b]0;Session : 2 [1-2] ✳ float-compare-bug-hunter - tmux\u0007\u001b[?25l\u001b[18d─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[32m───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b(B\u001b[m\u001b[1;1H  │ A     │ \u001b[38;5;153mmoving_average\u001b[39m  │ \u001b[38;5;153mrange(len(nums)-window)\u001b[39m가 마지막 구간을 빠뜨림                   │ \u001b[38;5;153mrange(len(nums)-window+1)\u001b[39m                                │   \u001b[48;5;235m                                                                                          \u001b[49m\u001b[2;1H  ├───────┼─────────────────┼──────────────────────────────────────────────────────────────────┼──────────────────────────────────────────────────────────┤   \u001b[48;5;235m \u001b[1m2 files\u001b(B\u001b[m\u001b[48;5;235m changed \u001b[38;5;72m+5\u001b[39m \u001b[38;5;174m-3\u001b[39m                                                                  \u001b[38;5;246m✕\u001b[39m \u001b[49m\u001b[3;1H  │ B     │ \u001b[38;5;153mis_close_enough\u001b[39m │ \u001b[38;5;153mtolerance\u001b[39m를 받아놓고 실제론 \u001b[38;5;153ma == b\u001b[39m 정확 비교만 함                │ \u001b[38;5;153mabs(a-b) <= tolerance\u001b[39m                                    │   \u001b[48;5;235m                                                                                          \u001b[49m\u001b[4;1H  ├───────┼─────────────────┼──────────────────────────────────────────────────────────────────┼──────────────────────────────────────────────────────────┤   \u001b[48;5;235m \u001b[38;5;246mexamples/agent-teams-practice/agent-team-demo.cast\u001b[39m                                       \u001b[49m\u001b[5;1H  │ C(저) │ \u001b[38;5;153madd_record\u001b[39m      │ \u001b[38;5;153mhistory=[]\u001b[39m 가변 기본 인자가 함수 정의 시 한 번만 생성돼 호출 간  │ \u001b[38;5;153mhistory=None\u001b[39m +