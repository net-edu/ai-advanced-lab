[233.212678, "o", "\u001b[19A\u001b[38;5;231m●\u001b[C\u001b[39m팀원\u001b[CA\u001b[C작업을\u001b[C완료해\u001b[C리더(state-share-bug-hunter)에게\u001b[C보고했습니다.\u001b[41;159H\u001b[48;5;235m                                                                                          \u001b[42;3H\u001b[49m                    \u001b[42;159H\u001b[48;5;235m \u001b[1m0 files\u001b(B\u001b[m\u001b[48;5;235m changed                                                                        \u001b[38;5;246m✕\u001b[39m \u001b[43;3H\u001b[49m-\u001b[C\u001b[1m버그\u001b(B\u001b[m:\u001b[C\u001b[38;5;153mrange(len(nums) - window)\u001b[39m가\u001b[C마지막\u001b[C윈도우를\u001b[C하나\u001b[C빠뜨림\u001b[43;159H\u001b[48;5;235m                                                                                          \u001b[44;1H\u001b[49m \u001b[C- \u001b[1m수정\u001b(B\u001b[m: \u001b[38;5;153mrange(len(nums) - window + 1)\u001b[39m \u001b[C      \u001b[C           \u001b[44;159H\u001b[48;5;235m \u001b[38;5;231m*\u001b[39m \u001b[38;5;246m Loading diff…\u001b[39m                                                                         \u001b[45;3H\u001b[49m-\u001b[C\u001b[1m검증\u001b(B\u001b[m:\u001b[C직접\u001b[C파일\u001b[C확인\u001b[C+\u001b[C테스트\u001b[C재실행으로\u001b[C3개\u001b[C모두\u001b[C통과\u001b[C확인\u001b[C완료\u001b[45;159H\u001b[48;5;235m                                                                                          \u001b[46;1H\u001b[49m \u001b[C    \u001b[C             \u001b[C              \u001b[C      \u001b[C      \u001b[C      \u001b[C    \u001b[C         \u001b[C        \u001b[C      \u001b[C             \u001b[46;159H\u001b[48;5;235m                                                                                          \u001b[47;159H                                                                                          \u001b[48;1H\u001b[49m\u001b[38;5;114m●\u001b[C\u001b[39mTeammate\u001b[C\u001b[38;5;110m\u001b[1m@team-a-boundary\u001b[C\u001b(B\u001b[mfinished\u001b[48;159H\u001b[48;5;235m     