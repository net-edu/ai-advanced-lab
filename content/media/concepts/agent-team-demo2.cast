[161.96954, "o", "\u001b[H                                                                                                                          \r\n                                    \u001b[3;3H\u001b[38;5;246mRead \u001b[1m1\u001b(B\u001b[m\u001b[38;5;246m file \r\n\u001b[39m \u001b[C  \u001b[C        \u001b[C    \u001b[C    \u001b[C    \u001b[C      \u001b[C             \u001b[C    \u001b[C       \u001b[C  \u001b[C      \u001b[C            \u001b[C    \u001b[C                    \r\n\u001b[38;5;231m●\u001b[C\u001b[39m원인\u001b[C진단:\u001b[C\u001b[38;5;153madd_record(value, history=[])\u001b[39m의\u001b[C기본\u001b[C인자\u001b[C\u001b[38;5;153mhistory=[]\u001b[39m는\u001b[C함수\u001b[C정의\u001b[C시점에\u001b[C\u001b[1m단 한 번\u001b[C\u001b(B\u001b[m생성되어\u001b[C이후\u001b[C모든\u001b[C호출이\u001b[C같은\u001b[C리스트\u001b[C객체를\u001b[C공유합니다.\u001b[C그래서\u001b[6;3H\u001b[38;5;153madd_record(10)\u001b[C\u001b[39m→\u001b[C\u001b[38;5;153madd_record(20)\u001b[39m을\u001b[C연달아\u001b[C호출하면\u001b[C두\u001b[C번째\u001b[C호출도\u001b[C첫\u001b[C번째\u001b[C호출이\u001b[C채운\u001b[C그\u001b[C리스트에\u001b[C이어서\u001b[Cappend\u001b[C되어\u001b[C\u001b[38;5;153m[10, 20]\u001b[39m이\u001b[C나오고,\u001b[C테스트가\u001b[C기대하는\u001b[7;3H\u001b[38;5;153m[20]\u001b[39m(독립적인\u001b[C새\u001b[C기록)과\u001b[C어긋납니다.\u001b[C파이썬의\u001b[C잘\u001b[C알려진\u001b[C\"mutable\u001b[Cdefault\u001b[Cargument\"\u001b[C함정입니다.\r\n \u001b[C    \u001b[C     \u001b[C                               \u001b[C    \u001b[C    \u001b[C            \u001b[C    \u001b[C    \u001b[C      \u001b[C        \u001b[C        \u001b[C    \u001b[C    \u001b[C      \u001b[C    \u001b[C      \u001b[C      \u001b[C           \u001b[C      \u001b[9;13H만 수정합니다(다른 두 함수는 팀원 A·B 담당이므로 건드리지\u001b[C않음).     \u001b[C    \u001b[C  \u001b[C        \u001b[C      \u001b[C      \u001b[C    \u001b[C          \u001b[C       \u001b[C        \u001b[C        \u001b[10;3H             \u001b[C  \u001b[C       \u001b[C           \u001b[C        \u001b[C  \u001b[C      \u001b[C        \u001b[C       \u001b[C         \u001b[C           \r\n\u001b[38;5;174m·\u001b[CBillowing\u001b[38;5;216m…\u001b[38;5;174m \u001b[38;5;246m(1m 32s · ↓\u001b[C6.9k tokens)\u001b[14;3H\u001b(B\u001b[m"]
