[28.618358, "o", "\u001b[1d├────────────────────────┼────────────────────────────────┼─────────────────────────────────────────────────┼──────────────────────────────────────────┤\u001b[2;5H\u001b[38;5;153mis_close_enough\u001b[2;30H\u001b[39m팀원 B                    \u001b[2;63H\u001b[38;5;153ma == b\u001b[39m 정확 비교라 \u001b[38;5;153m0.1+0.2 != 0.3\u001b[39m 에서\u001b[CFalse.\u001b[2;113H\u001b[38;5;153mabs(a - b) <= tolerance\u001b[3;3H\u001b[39m│ 부동소수점 오차        │ (float-compare-bug-hunter)     │ 시그니처의 \u001b[38;5;153mtolerance\u001b[39m 파라미터를 안 씀           │                                          │\u001b[4;3H├────────────────────────┼────────────────────────────────┼─────────────────────────────────────────────────┼──────────────────────────────────────────┤\u001b[5;5H\u001b[38;5;153madd_record\u001b[C\u001b[39m상태\u001b[C공유\u001b[5;30H저 (state-share-bug-hunter,\u001b[5;63H\u001b[38;5;153mhistory=[]\u001b[39m mutable default\u001b[Cargument\u001b[C가\u001b[C함수\u001b[5;120H\u001b[38;5;153m=None\u001b[39m 기본값 + 함수 내부에서\u001b[C\u001b[38;5;153mif \u001b[6;3H\u001b[39m│                        │ 팀원 C)                        │ 호출 간 공유돼 누적됨                           │ \u001b[38;5;153mhistory is None: history = []\u001b[39m            │\u001b[7;159H\u001b[K\u001b[8;3H\u001b[38;5;153m/doc-polish                   content/ 안 문서를 교정·윤문·개선하는 전 과정을 조율한다. 스냅샷을 뜨고, 계량하고, style-guardian 에게 검수를 시키고, copy-editor 에게 적용시키고, guard.py 로 보호 구간을 검증한 뒤 결과를 기록한다. \"문서 윤문해줘\",\u001b[39m\u001b[K\u001b[9;3H             \u001b[C              \u001b[C \u001b[38;5;153m\"이 문서 다듬어줘\", \"오탈자 잡아줘\", \"어체 통일해줘\", \"교정해줘\" 같은 요청에\u001b[C쓴다. 파이프라인은 건드리지 않는다. (project)\u001b[39m\u001b[9;159H\u001b[K\u001b[10;3H\u001b[38;5;246m/code-embed                   예시 코드·설정 파일(SKILL.md, YAML, 스크립트 등)을 에디터 창처럼 디자인해 content/ 문서에 접기/펼치기 위젯으로 붙인다. \"이 코드 예시 넣어줘\", \"설정 파일 펼치기로 보여줘\", \"코드블록 UI 이쁘게 만들어줘\" 같은 요청에\u001b[39m\u001b[K\r\n \u001b[C                              \u001b[38;5;246m쓴다. (project)\u001b[39m\u001b[11;159H\u001b[K\u001b[12;3H\u001b[38;5;246m/init                         Initialize a new CLAUDE.md file with codebase documentation\u001b[14;3H\u001b[39m/\u001b[17;45H\u001b[38;5;246m/diff to hide \u001b[39m\u001b[17;63H\u001b[K\u001b[14;4H"]
