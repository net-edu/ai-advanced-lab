[28.750787, "o", "\u001b[8;4H\u001b[38;5;153m\u001b[1mc\u001b(B\u001b[m\u001b[38;5;153md        \u001b[8;33HM\u001b[Cve this session to a new working dire\u001b[1mc\u001b(B\u001b[m\u001b[38;5;153mtory\u001b[39m\u001b[K\u001b[9;3H\u001b[38;5;246m/\u001b[39m\u001b[1mc\u001b(B\u001b[m\u001b[38;5;246mopy                         \u001b[39m\u001b[1mC\u001b(B\u001b[m\u001b[38;5;246mopy Claude's last response to clipboard (or /copy N for the Nth-latest)\u001b[39m\u001b[K\u001b[10;4H\u001b[1mc\u001b(B\u001b[m\u001b[38;5;246mlear     \u001b[10;33HStart a new session with e\u001b[Cpty \u001b[39m\u001b[1mc\u001b(B\u001b[m\u001b[38;5;246montext; previous session stays on disk (resumable with /resume)\u001b[39m\u001b[K\u001b[11;3H\u001b[38;5;246m/\u001b[39m\u001b[1mc\u001b(B\u001b[m\u001b[38;5;246molor                        Set the promp\u001b[C bar \u001b[39m\u001b[1mc\u001b(B\u001b[m\u001b[38;5;246molor for this session\u001b[12;4H\u001b[39m\u001b[1mc\u001b(B\u001b[m\u001b[38;5;246mhrome\u001b[12;33HOpen \u001b[39m\u001b[1mC\u001b[C\u001b(B\u001b[m\u001b[38;5;246maude i\u001b[C Chrome settings\u001b[39m\u001b[K\u001b[14;5H"]
