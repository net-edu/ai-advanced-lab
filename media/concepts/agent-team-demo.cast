[224.937301, "o", "\u001b[14;69H\u001b[38;5;114m●\u001b[?69h\u001b(B\u001b[m\u001b[?12l\u001b[?25h\u001b[?1006l\u001b[?1000l\u001b[?1002l\u001b[?1003l\u001b[1;1H\u001b[1;44r\u001b[1;44r\u001b[s\u001b[15;69H\u001b[38;5;246m  ⎿  \u001b[39mAdded\u001b[C\u001b[1m1\u001b[C\u001b(B\u001b[mline,\u001b[Cremoved\u001b[C\u001b[1m1\u001b[C\u001b(B\u001b[mline\u001b[16;74H\u001b[38;5;231m\u001b[2m 1 \u001b(B\u001b[m\u001b[38;5;231m \u001b[38;5;81mdef\u001b[38;5;231m \u001b[38;5;148mmoving_average\u001b[38;5;231m(\u001b[38;5;208mnums, window\u001b[38;5;231m):\u001b[17;74H\u001b[2m 2 \u001b(B\u001b[m\u001b[38;5;231m     \u001b[38;5;186m\"\"\"구간 평균을 window 크기만큼 슬라이딩하며 계산\u001b[18;74H\u001b[38;5;231m\u001b[2m   \u001b(B\u001b[m\u001b[38;5;231m \u001b[38;5;186m한다.\"\"\"\u001b[19;74H\u001b[38;5;231m\u001b[2m 3 \u001b(B\u001b[m\u001b[38;5;231m     result = []\u001b[20;74H\u001b[38;5;167m\u001b[48;5;52m 4 -\u001b[38;5;231m    for i in range(len(nums) - window):             \u001b[21;74H\u001b[38;5;77m\u001b[48;5;22m 4 +\u001b[38;5;231m    \u001b[38;5;197mfor\u001b[38;5;231m i \u001b[38;5;197min\u001b[38;5;231m \u001b[38;5;148mrange\u001b[38;5;231m(\u001b[38;5;148mlen\u001b[38;5;231m(nums) - window\u001b[48;5;28m + \u001b[38;5;141m1\u001b[38;5;231m\u001b[48;5;22m):         \u001b[22;74H\u001b[49m\u001b[2m 5 \u001b(B\u001b[m\u001b[38;5;231m         segment = nums[i:i + window]\u001b[23;74H\u001b[2m 6 \u001b(B\u001b[m\u001b[38;5;231m         result.append(\u001b[38;5;148msum\u001b[38;5;231m(segment) / window)\u001b[24;74H\u001b[2m 7 \u001b(B\u001b[m\u001b[38;5;231m     \u001b[38;5;197mreturn\u001b[38;5;231m result\u001b[37;103H\u001b[38;5;246m · \u001b[38;5;248mthinking with high effort\u001b[38;5;246m)\u001b[40;3H\u001b[?1006l\u001b[?1000l\u001b[?1002l\u001b[?1003l\u001b[?1006h\u001b[?1000h\u001b[?1002h\u001b[?1003h\u001b(B\u001b[m"]
