ugh\u001b[39m 부동소수점 오차\u001b[28X\u001b[28;3H\u001b[1m담당\u001b[28;9H\u001b(B\u001b[m팀원 B (float-compare-bug-hunter)\u001b[29;3H\u001b[1m원인\u001b[29;9H\u001b(B\u001b[m\u001b[38;5;153ma == b\u001b[C\u001b[39m정확 비교라 \u001b[38;5;153m0.1+0.2 != 0.3\u001b[C\u001b[39m에서\u001b[CFalse.\u001b[C시그니처의\u001b[30;3H\u001b[38;5;153mtolerance\u001b[39m 파라미터를 안 씀\u001b[39X\u001b[31;3H\u001b[1m수정:\u001b(B\u001b[m \u001b[38;5;153mabs(a - b) <= tolerance\u001b[32;3H\u001b[39m────────────────────────────────────────\u001b[33;3H\u001b[1m버그:\u001b(B\u001b[m \u001b[38;5;153madd_record\u001b[39m 상태 공유\u001b[39X\u001b[34;3H\u001b[1m담당\u001b[34;9H\u001b(B\u001b[m저 (state-share-bug-hunter,\u001b[C팀원\u001b[CC)\u001b[35;3H\u001b[1m원인\u001b[35;9H\u001b(B\u001b[m\u001b[38;5;153mhistory=[]\u001b[39m mutable default argument\u001b[C가\u001b[C함수\u001b[C호출\u001b[C간\u001b[C공유돼\u001b[36;3H누적됨\u001b[59X\n`history=\u001b[40;3H"]
