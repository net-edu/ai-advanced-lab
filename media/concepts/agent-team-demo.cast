[280.89566, "o", "\u001b[34;3H\u001b[K\n\u001b[38;5;153m/\u001b[1mex\u001b(B\u001b[m\u001b[38;5;153mit                         \u001b[1mEx\u001b(B\u001b[m\u001b[38;5;153mit the CLI\u001b[39m\u001b[K\u001b[36;5H\u001b[1mx\u001b[36;34Hx\u001b[37;4H\u001b(B\u001b[m\u001b[38;5;246mmem\u001b[39m\u001b[1mex\u001b(B\u001b[m\u001b[38;5;246m-search\u001b[37;33HSearch across Mem\u001b[39m\u001b[1mex\u001b(B\u001b[m\u001b[38;5;246m notes and mail while\u001b[Cpreserving source boundaries, or trace backlinks to a note or\u001b[Cmail message. Use for sou\u001b[Cce-agnostic vault\u001b[Cse\u001b[37;184Hch, note\u001b[38;33Hlookup, Korean-English query\u001b[C\u001b[39m\u001b[1mex\u001b(B\u001b[m\u001b[38;5;246mpansion, \"search/find in\u001b[CMemex\", \"노트 찾아\", \"볼트에서 검색\", \"영어로도 찾아줘\u001b[C, \"역참조\", or\u001b[C\"백링크\". Use memex-read for the\u001b[40;6H\u001b(B\u001b[m"]
