[271.305412, "o", "\u001b[1;144H\u001b[38;5;231m\u001b[2m 9\u001b(B\u001b[m\u001b[1;148H\u001b[K\u001b[2;144H\u001b[38;5;231m\u001b[2m10\u001b[2;148H\u001b(B\u001b[m\u001b[38;5;81mdef\u001b[38;5;231m \u001b[38;5;148mis_close_enough\u001b[38;5;231m(\u001b[38;5;208ma, b, tolerance=\u001b[38;5;141m0.0\u001b[3;144H\u001b[38;5;231m\u001b[2m  \u001b[3;148H\u001b(B\u001b[m\u001b[38;5;141m001\u001b[38;5;231m):\u001b[39m\u001b[K\u001b[4;144H\u001b[38;5;231m\u001b[2m11\u001b[4;148H\u001b(B\u001b[m\u001b[38;5;231m    \u001b[38;5;186m\"\"\"두 실수가 tolerance 이내로 같은\u001b[5;143H\u001b[38;5;231m\u001b[2m    \u001b(B\u001b[m\u001b[38;5;231m \u001b[38;5;186m지 검사한다.\"\"\"\u001b[39m\u001b[K\u001b[6;143H\u001b[38;5;167m\u001b[48;5;52m 12 -\u001b[38;5;231m    return a == b                      \u001b[7;143H\u001b[38;5;77m\u001b[48;5;22m 12 +\u001b[38;5;231m    \u001b[38;5;197mreturn\u001b[38;5;231m \u001b[38;5;148mabs\u001b[38;5;231m(a - b) <= tolerance     \u001b[8;145H\u001b[49m\u001b[2m3\u001b[9;145H4\u001b(B\u001b[m\u001b[9;148H\u001b[K\u001b[10;143H\u001b[38;5;231m\u001b[2m 15 \u001b(B\u001b[m\u001b[38;5;231m \u001b[38;5;81mdef\u001b[38;5;231m \u001b[38;5;148madd_record\u001b[38;5;231m(\u001b[38;5;208mvalue, history=\u001b[38;5;141mNone\u001b[38;5;231m):\u001b[39m\u001b[11;140H\u001b[K\n\u001b[38;5;246mRan \u001b[1m2\u001b(B\u001b[m\u001b[38;5;246m shell commands \u001b[39m\u001b[13;138H\u001b[K\n\u001b[38;5;231m●\u001b[C\u001b[39mAll thr\u001b[Ce\u001b[Ctests pass now - looks like the other two\u001b[K\u001b[15;140Hteammat\u001b[Cs already\u001b[Cfixed \u001b[38;5;153mmoving_average\u001b[39m and\u001b[C\u001b[38;5;153madd_record\u001b[39m\u001b[K\u001b[16;138H  concurrently. Let me report my fix back\u001b[Cto\u001b[Cteammate\u001b[CC.\u001b[17;138H\u001b[38;5;246m  ⎿  “i\u001b[C_close_enough 버그 수정 완료” → \u001b[39m\u001b[K\u001b[18;143H\u001b[38;5;246muds:/run/user/1000/cc-socks/1947354.sock\u001b[39m\u001b[19;138H\u001b[K\n\u001b[38;5;231m●\u001b[C\u001b[38;5;153mis_close_enough\u