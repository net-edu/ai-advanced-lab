\u001b[m 팀원\u001b[CA\u001b[C(boundary-bug-hunter)\u001b[31;3H\u001b[1m원인:\u001b[C\u001b(B\u001b[m\u001b[38;5;153mrange(len(nums) - window)\u001b[C\u001b[39m가\u001b[C마지막\u001b[C구간을\u001b[C순회\u001b[C전에\u001b[C끝냄\r\n \u001b[C\u001b[1m수정\u001b[C\u001b(B\u001b[m \u001b[38;5;153mrange(len(nums) - window + 1)\u001b[33;3H\u001b[39m────────────────────────────────────────\u001b[34;9H\u001b[38;5;153mis_close_\u001b[Cnough\u001b[39m\u001b[44X\u001b[35;9H\u001b[59X\n\u001b[59X\n\u001b[59X\u001b[40;3H"]
